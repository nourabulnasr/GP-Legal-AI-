# Production .env for Hostinger VPS (full mode)
# Secrets SECRET_KEY / JWT_SECRET_KEY are generated by bootstrap.sh if not preset.

FRONTEND_URL=https://legatoappgp2026.web.app
CORS_ORIGINS=https://legatoappgp2026.web.app,https://legatoappgp2026.firebaseapp.com,https://nourabulnasr-legato.hf.space

DATABASE_URL=sqlite:////data/legalai.db
CHROMA_LEGAL_DIR=/data/chroma_legal
ENABLE_STARTUP_RAG=1
WARMUP_LFM_AT_STARTUP=1
DOCUMENT_CHAT_GEMINI_FALLBACK=0
LEGAL_RAG_QUERY_BACKEND=chroma_first
LOCAL_LLM_PATH=/models/lfm
LOCAL_LORA_PATH=/models/lora

# Google OAuth — register this exact URI in Cloud Console (Web client). Do NOT use raw IP; Google rejects it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://srv1723974.hstgr.cloud/auth/google/callback
# Public API URL for post image links (must match Flutter/web API_BASE_URL)
IMAGE_BASE_URL=https://srv1723974.hstgr.cloud
# Gemini chat assistant (/chat/assistant, /chat/message, negotiation). Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

LOCAL_LLM_HOST_PATH=/opt/gp-legal-ai/models/LFM2.5-1.2B-Thinking
LOCAL_LORA_HOST_PATH=/opt/gp-legal-ai/models/out_adapter

# Paymob — TEST (sandbox) by default; switch to live keys only after commercial approval
PAYMOB_MODE=test
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_WEBHOOK_URL=https://srv1723974.hstgr.cloud/api/payments/paymob/webhook
PAYMOB_SUCCESS_URL=https://legatoappgp2026.web.app/
PAYMOB_FAILURE_URL=https://legatoappgp2026.web.app/
