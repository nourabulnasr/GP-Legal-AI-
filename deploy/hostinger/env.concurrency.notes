# Optional production tuning — review CONCURRENCY_REPORT.md before applying.
# These are NOT enabled on the VPS by default.

# Keep one uvicorn process while LFM is in-process (~2.4 GiB RSS).
# Do NOT set UVICORN_WORKERS>1 unless LFM runs in a separate service.

# Startup (already in env.production.template):
# ENABLE_STARTUP_RAG=1
# WARMUP_LFM_AT_STARTUP=1

# Future: after session.py sets WAL + busy_timeout in code:
# SQLITE_BUSY_TIMEOUT_MS=30000

# Future: external LFM queue worker
# LFM_REMOTE_URL=http://lfm-worker:8081
