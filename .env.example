# =========================
# Legato Backend - Environment
# =========================
# Copy this file to .env and fill in your values.
# Example: copy .env.example .env

# =========================
# Database (required for auth & save)
# =========================
# Default: sqlite:///./legalai.db in project root
# DATABASE_URL=sqlite:///./legalai.db

# =========================
# JWT (required for auth)
# =========================
# SECRET_KEY=your-secret-key-change-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# =========================
# SMTP - Password reset emails (step-by-step)
# =========================
# To enable "Forgot password" emails:
#
# 1. For Gmail:
#    - SMTP_HOST=smtp.gmail.com
#    - SMTP_PORT=587
#    - SMTP_USER=your-email@gmail.com
#    - SMTP_PASSWORD=your-app-password  (NOT your regular password!)
#      Get App Password: Google Account → Security → 2-Step Verification → App passwords
#    - SMTP_FROM=noreply@legato.local (or same as SMTP_USER)
#
# 2. For other providers (Outlook, Yahoo, etc.):
#    - SMTP_HOST=smtp.example.com  (check your provider docs)
#    - SMTP_PORT=587 (TLS) or 465 (SSL)
#    - SMTP_USER=your-email
#    - SMTP_PASSWORD=your-password-or-app-password
#    - SMTP_FROM=noreply@legato.local
#
# 3. If SMTP is NOT set: reset links/codes are printed to the console (dev mode)
# 4. Port 587 = STARTTLS, 465 = SSL (both supported)
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=nourabulnasr@gmail.com
SMTP_PASSWORD=
SMTP_FROM=noreply@legato.local

# Verification code flow (forgot-password sends code; frontend calls /verify-reset-code to get reset_token)
# VERIFICATION_CODE_EXPIRE_MINUTES=30
# RESET_TOKEN_AFTER_CODE_EXPIRE_MINUTES=30

# =========================
# Frontend URL (for password reset links, Google OAuth redirects)
# =========================
# Must match where your frontend runs
FRONTEND_URL=http://localhost:5173

# =========================
# Google OAuth (SSO login)
# =========================
# Get these from: https://console.cloud.google.com/apis/credentials
# Google OAuth (SSO login) — use your Firebase web app domain (Google rejects raw IPs).
# 1. Cloud Console → Credentials → OAuth 2.0 Client ID → Web application
# 2. Authorized JavaScript origins:
#      https://legatoappgp2026.web.app
# 3. Authorized redirect URIs (required for Flutter web Google Sign-In):
#      https://legatoappgp2026.web.app
#    Do NOT use http://76.13.4.148 or https://srv1723974.hstgr.cloud — Google blocks IP/non-standard setups.
# 4. OAuth consent screen → add your email as Test user (while in Testing mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# =========================
# Chat (Gemini) - Step-by-step
# =========================
# To enable the contract-aware chatbot:
#
# 1. Go to: https://aistudio.google.com/apikey
# 2. Create an API key (or use existing)
# 3. Paste it here (no quotes needed):
#
GEMINI_API_KEY=
# Optional alias if you already use GOOGLE_API_KEY elsewhere:
# GOOGLE_API_KEY=
#
# 4. Restart the backend. Chat page will use Gemini for Q&A about contracts.
# 5. If GEMINI_API_KEY is empty: chat shows "Set GEMINI_API_KEY to enable chat."
# Optional: model ID (default: gemini-2.0-flash). Use gemini-2.5-flash or gemini-2.0-flash.
# GEMINI_MODEL=gemini-2.0-flash

# =========================
# Local LFM model (Docker-first) — Thinking base + optional LoRA
# =========================
# Base model (required): LiquidAI/LFM2.5-1.2B-Thinking
# LoRA adapter (optional): out_adapter from Colab fine-tune
#
# Host folders must contain:
# Base: config.json, tokenizer files, model.safetensors (or shards)
# LoRA: adapter_config.json, adapter_model.safetensors, tokenizer.json (recommended)
#
# LOCAL_LLM_HOST_PATH=./models/LFM2.5-1.2B-Thinking
# LOCAL_LORA_HOST_PATH=./models/out_adapter
#
# Container paths (set by docker-compose):
# LOCAL_LLM_PATH=/models/lfm
# LOCAL_LORA_PATH=/models/lora
#
# Legacy Instruct-only (no adapter): point LOCAL_LLM_HOST_PATH at LFM2.5-1.2B-Instruct
# and leave LOCAL_LORA_HOST_PATH unset or empty.
#
# Translation + LID fallback via local LFM (phase rollout flags)
# ENABLE_LOCAL_LLM_TRANSLATION=1
# ENABLE_LOCAL_LLM_LID_FALLBACK=1
# LOCAL_LLM_LID_THRESHOLD=0.35
#
# Document chat: 1 = allow Gemini when local LFM fails; 0 = return local error only (no quota confusion)
# DOCUMENT_CHAT_GEMINI_FALLBACK=0
#
# RAG: warm Chroma + chunk retriever at backend startup (recommended in Docker)
# ENABLE_STARTUP_RAG=1
#
# Chroma persistence directory (Docker compose sets this to /data/chroma_legal)
# Chroma persist dir: used by legal_rag_bridge when set, and by app/rag_chromadb (default ./chroma_legal).
# CHROMA_LEGAL_DIR=/data/chroma_legal
#
# Optional: override labor-law chunks JSONL (default picks Legal Rag/data, then chunks/)
# Generate/update corpus: python scripts/preprocess_labor14_2025.py
# LEGAL_RAG_DATA_PATH=
#
# Minimum similarity for RAG hits (default 0.02; raise e.g. to 0.05 for stricter matches)
# RAG_MIN_SCORE=0.02
#
# Law RAG query path: chroma_first (default) = Chroma then in-memory JSONL retriever; memory_only = JSONL retriever only (old RAG). When memory_only, admin reindex jobs succeed if retriever reload OK even if Chroma is skipped or fails.
# LEGAL_RAG_QUERY_BACKEND=chroma_first

# =========================
# Labor law auto-update (admin API + optional URL poll)
# =========================
# Direct PDF URL for conditional GET (If-None-Match / If-Modified-Since). Many official sites block bots; admin PDF upload is the reliable fallback.
# LAW_OFFICIAL_PDF_URL=
# LAW_POLL_ENABLED=0
# LAW_POLL_INTERVAL_SECONDS=86400
# Display name written into each extracted article (optional)
# LAW_DEFAULT_NAME=قانون العمل رقم 14 لسنة 2025
# Max upload size for POST /admin/law/upload-pdf (bytes)
# LAW_UPLOAD_MAX_BYTES=36700160
# Law PDF text extraction: auto = same pipeline as contract PDFs (Document AI + PyMuPDF/OCR); pymupdf_only = embedded text only (faster, fails on scanned PDFs)
# LAW_PDF_EXTRACTION_MODE=auto

# =========================
# OCR (optional)
# =========================
# OCR_SPACE_API_KEY=your-key

# Google Document AI (optional - for better PDF/OCR)
# DOCUMENT_AI_PROJECT_ID=your-gcp-project-id
# DOCUMENT_AI_LOCATION=us
# DOCUMENT_AI_PROCESSOR_ID=your-processor-id
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
# If this path is wrong inside Docker, remove the line or fix the path — a missing file is ignored for Translation when GOOGLE_TRANSLATION_API_KEY is set.

# Google Cloud Translation API (optional - for translating contracts to Arabic)
# Uses REST with the API key (no service account JSON required). Enable "Cloud Translation API" on the GCP project.
# GOOGLE_TRANSLATION_API_KEY=your-api-key-here

# =========================
# Device (optional)
# =========================
# auto = use CUDA if available else CPU; cpu | cuda
# DEVICE=auto

# =========================
# Hugging Face (optional)
# =========================
# Set HF_TOKEN for Hugging Face model downloads (avoids rate limits, enables gated models).
# Get token: https://huggingface.co/settings/tokens
# Used by: Legal RAG embeddings, llm/LFM model when downloading from Hub.
HF_TOKEN=your_huggingface_token_here
