<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is allowed only for listed dev/production hosts (API is HTTP until HTTPS is added).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Hostinger VPS — Legato production API -->
        <domain includeSubdomains="false">76.13.4.148</domain>
        <!-- Android emulator → host machine -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Dev machine LAN IP -->
        <domain includeSubdomains="false">192.168.1.10</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
